# Copy to .dev.vars for `npm run cf:dev`. Never commit the real file.
A2A_EXECUTION_MODE=competition
A2A_PUBLIC_BASE_URL=https://trade-town.example.workers.dev
A2A_API_KEY=replace-with-review-token
A2A_CONVEX_URL=https://replace-with-your-deployment.convex.cloud
A2A_CONVEX_SHARED_SECRET=replace-with-random-shared-secret
A2A_MAX_TASK_MS=1080000
A2A_MAX_PROMPT_CHARS=8000
A2A_RATE_LIMIT_PER_MINUTE=60

LLM_API_URL=https://replace-with-panda-deepseek-endpoint/v1
LLM_API_KEY=replace-with-deepseek-key
LLM_MODEL=replace-with-deepseek-v4-pro-model-id
