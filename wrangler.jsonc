{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tradetown",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "tradetown.net",
      "custom_domain": true
    }
  ]
}
