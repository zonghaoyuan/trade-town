{
  "name": "injective-trade-town",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "test:responsive": "playwright test",
    "test:responsive:update": "playwright test --update-snapshots",
    "predev": "convex dev --run init --until-success",
    "dev:backend": "convex dev --tail-logs",
    "dev:frontend": "vite",
    "dashboard": "convex dashboard",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --verbose",
    "gateway:dev": "tsx services/injective-gateway/src/index.ts",
    "gateway:check": "GATEWAY_MODE=read-only tsx services/injective-gateway/src/index.ts --once",
    "a2a:dev": "tsx services/market-town-a2a/src/index.ts",
    "a2a:examples": "tsx services/market-town-a2a/src/example-client.ts",
    "a2a:test": "NODE_OPTIONS=--experimental-vm-modules jest --verbose services/market-town-a2a",
    "cf:dev": "npm run build && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "provision:plan": "tsx services/injective-gateway/src/provision.ts",
    "provision:testnet": "tsx services/injective-gateway/src/provision.ts",
    "level-editor": "vite src/editor/",
    "le": "vite src/editor/"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0",
    "@injectivelabs/networks": "1.20.26",
    "@injectivelabs/sdk-ts": "1.20.26",
    "@injectivelabs/ts-types": "1.20.26",
    "@pixi/react": "^7.1.0",
    "@pixi/sound": "^5.2.0",
    "@tailwindcss/forms": "^0.5.3",
    "@types/node": "^22.15.30",
    "@types/react": "18.2.8",
    "@types/react-dom": "18.2.4",
    "clsx": "^2.0.0",
    "convex": "^1.41.0",
    "dotenv": "^16.1.4",
    "eslint": "8.42.0",
    "express": "^5.1.0",
    "lightweight-charts": "^5.2.0",
    "pixi-viewport": "^5.0.1",
    "pixi.js": "^7.2.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-toastify": "^9.1.3",
    "replicate": "^0.18.0",
    "update-browserslist-db": "^1.1.2",
    "uplot": "^1.6.25",
    "usehooks-ts": "^2.9.1"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.2.14",
    "@playwright/test": "^1.61.1",
    "@types/css-font-loading-module": "^0.0.8",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.4",
    "@types/ws": "^8.5.5",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "@vitejs/plugin-react": "6.0.4",
    "autoprefixer": "^10.4.15",
    "concurrently": "^8.2.0",
    "jest": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.28",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "type": "module"
}
