# Frontend and Convex
VITE_CONVEX_URL=
CONVEX_DEPLOYMENT=
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
# Use local-hash when the chat gateway does not expose /v1/embeddings.
LLM_EMBEDDING_MODEL=local-hash

# Convex + Gateway shared authentication
CONVEX_URL=
GATEWAY_SHARED_SECRET=

# The default is safe and never signs.
GATEWAY_MODE=read-only
GATEWAY_POLL_INTERVAL_MS=5000

# Dedicated Injective Testnet wallet only. Never use a mainnet key.
INJECTIVE_OPERATOR_ADDRESS=
INJECTIVE_PRIVATE_KEY=

# Filled after TokenFactory denoms and spot markets are launched on Injective Testnet.
INJECTIVE_MARKET_ACME=
INJECTIVE_MARKET_NOVA=
INJECTIVE_MARKET_AURUM=
INJECTIVE_MARKET_CRUDE=

# Required only for an explicit TokenFactory/market launch transaction.
TESTNET_PROVISION_CONFIRM=
