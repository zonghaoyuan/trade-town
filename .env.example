# Frontend and Convex
VITE_CONVEX_URL=
CONVEX_DEPLOYMENT=

# OpenAI-compatible API configuration. A2A also accepts ARK_API_KEY as the
# credential when LLM_API_KEY is empty. Never commit a real key.
LLM_API_KEY=
ARK_API_KEY=
LLM_API_URL=
LLM_MODEL=
# Use local-hash when the chat gateway does not expose /v1/embeddings.
LLM_EMBEDDING_MODEL=local-hash

# External order-intent authentication
CONVEX_URL=
INJECTIVE_CONTROL_SECRET=

# Convex Injective worker. The default is safe and never signs.
INJECTIVE_EXECUTION_MODE=read-only
# Dedicated Injective Testnet wallet only. Never use a mainnet key. Store these
# with `npx convex env set` for the deployment that runs the worker.
INJECTIVE_OPERATOR_ADDRESS=
INJECTIVE_PRIVATE_KEY=

# Filled after the ACME/INJ MVP market is launched on Injective Testnet.
INJECTIVE_MARKET_ACME=
# Future markets: uncomment after enabling the matching symbol in provisionConfig.ts.
# INJECTIVE_MARKET_NOVA=
# INJECTIVE_MARKET_AURUM=
# INJECTIVE_MARKET_CRUDE=

# Required only for an explicit TokenFactory/market launch transaction.
TESTNET_PROVISION_CONFIRM=

# PandaAI A2A Remote Agent
A2A_PORT=41241
A2A_PUBLIC_BASE_URL=http://127.0.0.1:41241
# local-demo allows explicitly labeled simulations; competition enforces HTTPS,
# Convex persistence and an OpenAI-compatible LLM configuration.
A2A_EXECUTION_MODE=local-demo
A2A_CONVEX_URL=
A2A_CONVEX_SHARED_SECRET=
A2A_MAX_TASK_MS=1080000
A2A_MAX_PROMPT_CHARS=8000
A2A_RATE_LIMIT_PER_MINUTE=60

# Optional: external backend for a precomputed 30-trading-day LLM Town run.
# The browser does not access this service; the replay bridge and A2A service do.
TOWN_BACKEND_URL=http://127.0.0.1:8000
TOWN_RUN_ID=
TOWN_REPLAY_TOTAL_DAYS=30
TOWN_REPLAY_SHARED_SECRET=
